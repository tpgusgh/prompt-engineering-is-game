{
  "name": "prompt-engineering-is-game",
  "version": "0.29.4",
  "description": "Turn-based RPG wrapper around real AI coding — longer prompts hit harder.",
  "type": "module",
  "main": "electron/main.ts",
  "bin": {
    "promptbattle": "./src/cli.ts"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "test": "node --test test/*.test.ts",
    "electron:start": "electron .",
    "electron:build": "electron-builder",
    "release": "node scripts/release.mjs"
  },
  "license": "MIT",
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.283",
    "electron-updater": "^6.8.9",
    "marked": "^18.0.14"
  },
  "devDependencies": {
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "lucide-static": "^1.49.0"
  },
  "build": {
    "appId": "com.promptbattle.app",
    "productName": "Prompt Battle",
    "files": [
      "src/**/*.ts",
      "electron/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/@anthropic-ai/claude-agent-sdk-*/**"
    ],
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.developer-tools",
      "icon": "build/icon.icns",
      "files": [
        "!node_modules/@anthropic-ai/claude-agent-sdk-linux-*/**",
        "!node_modules/@anthropic-ai/claude-agent-sdk-win32-*/**"
      ]
    },
    "directories": {
      "output": "release"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Development",
      "icon": "build/icon.png",
      "files": [
        "!node_modules/@anthropic-ai/claude-agent-sdk-darwin-*/**",
        "!node_modules/@anthropic-ai/claude-agent-sdk-win32-*/**",
        "!node_modules/@anthropic-ai/claude-agent-sdk-linux-*-musl/**"
      ]
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.png",
      "files": [
        "!node_modules/@anthropic-ai/claude-agent-sdk-darwin-*/**",
        "!node_modules/@anthropic-ai/claude-agent-sdk-linux-*/**"
      ]
    },
    "artifactName": "PromptBattle-${version}-${os}-${arch}.${ext}",
    "publish": [
      {
        "provider": "github",
        "owner": "tpgusgh",
        "repo": "prompt-engineering-is-game"
      }
    ],
    "electronFuses": {
      "runAsNode": false,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "onlyLoadAppFromAsar": true
    },
    "afterSign": "scripts/after-sign.cjs"
  }
}
